#Область  unixtime

Функция ДатаUnixtime(ДатаВремя1С = Неопределено)  Экспорт
	
	ТДатаВремя1С = ?(ТипЗнч(ДатаВремя1С) = Тип("Дата"), ДатаВремя1С, ТекущаяДатаСеанса());
	//ДатаUnixtime = Формат(Число(ТДатаВремя1С - Дата("19700101")),"ЧН=0; ЧГ=0");
	ДатаUnixtime = Формат(Число(ТДатаВремя1С - Дата("19700101") - 7*60*60),"ЧН=0; ЧГ=0");  // с учетом часового пояса
	Возврат   ДатаUnixtime;

КонецФункции // ДатаUnixtime()
 
Функция ДатаВремя1С_Unixtime(ДатаUnixtime)  Экспорт
	
	Попытка
	    ТДатаUnixtime = ?(ТипЗнч(ДатаUnixtime) = Тип("Строка"), Число(ДатаUnixtime), ДатаUnixtime);
		//ДатаВремя1С = Дата("19700101")+ ТДатаUnixtime;
		ДатаВремя1С = Дата("19700101")+ ТДатаUnixtime + 7*60*60;  // с учетом часового пояса
	Исключение
		Возврат Неопределено;
	КонецПопытки;	
	
	Возврат   ДатаВремя1С;

КонецФункции // Дата1CUnixtime()

